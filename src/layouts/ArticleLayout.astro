---
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import type { Props as SEOProps } from '../components/SEO.astro';

interface Props {
  content: Record<string, any>;
  schemaType: SEOProps['schemaType'];
}

const { content, schemaType } = Astro.props;
const image = await getImage({ src: content.img, width: 1700, height: 800, format: 'avif' });
---

<BaseLayout
  title={content.title}
  description={content.description}
  image={content.img}
  lang={content.lang || 'en'}
  currentPage={Astro.url.pathname}
  type="article"
  schemaType={schemaType}
  published={content.publishDate}
  keywords={content.tags}
  projectUrl={content.link}
>
  <div class="terminal-container">
    <article class="article-content">
      <header>
        <p class="article-path">cat {Astro.url.pathname.replace(/\/$/, '')}.md</p>
        <h1>{content.title}</h1>
        <p>{content.description}</p>
        <ul class="tags" aria-label="Tags">
          {content.tags?.map((tag: string) => <li>{tag}</li>)}
        </ul>
        <img src={image.src} width={image.attributes.width} height={image.attributes.height} alt={content.title} />
        {content.link && <p><a href={content.link} target="_blank" rel="noopener noreferrer">View project</a></p>}
      </header>
      <div class="prose"><slot /></div>
      <footer><a href="/projects/">View more projects</a></footer>
    </article>
  </div>
</BaseLayout>

<style>
  .article-content {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.5rem;
    color: var(--color-text);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }
  .article-path, .tags { color: var(--color-accent); }
  h1 { line-height: 1.3; }
  img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .tags { display: flex; flex-wrap: wrap; gap: 1rem; padding: 0; list-style: none; }
  .article-content :global(a) { color: var(--color-link); }
  .prose :global(pre) { overflow-x: auto; padding: 1rem; background: var(--color-surface); }
  .prose :global(img) { max-width: 100%; height: auto; }
  footer { margin-top: 3rem; }
</style>
