---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import TerminalNav from '../components/TerminalNav.astro';
import TerminalWip from '../components/TerminalWip.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import { defaultTheme } from '../themes';
import { isWip } from '../data/wip';

export interface Props extends HeadProps {
  currentPage?: string;
  lang?: string;
}

const { currentPage = '/', lang = 'en', ...head } = Astro.props;
const wip = isWip(currentPage);
---

<!DOCTYPE html>
<html lang={lang} data-theme={defaultTheme}>
  <head>
    <BaseHead {...head} noindex={wip ? true : head.noindex} />
    <slot name="head" />
  </head>
  <body>
    <TerminalNav currentPage={currentPage} />
    <main id="main-content">
      {wip ? <TerminalWip title={wip.title} note={wip.note} /> : <slot />}
    </main>
    <TerminalFooter />
  </body>
</html>
