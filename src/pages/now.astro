---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../shared/layouts/BaseLayout.astro';
import Prompt from '../shared/ui/Prompt.astro';
import { profile } from '../features/seo/seo';

// A /now page (nownownow.com): what I'm focused on at the moment. Edit src/content/now/now.md.
const entry = await getEntry('now', 'now');
if (!entry) throw new Error('src/content/now/now.md is missing');
const { Content } = await render(entry);
const { updated, location, placeholder } = entry.data;
---

<BaseLayout
  title={`Now | ${profile.contact.name}`}
  description={`What ${profile.contact.name} is focused on right now.`}
  currentPage="/now"
>
  <Prompt path="~" command="cat now.md" />
  <div class="output">
    <article class="prose">
      <h1>What I'm doing now</h1>
      {placeholder && (
        <p class="placeholder-note" role="note">Draft: this page still has placeholder text.</p>
      )}
      <p class="now-meta">
        Updated <time datetime={updated.toISOString().slice(0, 10)}>{updated.toISOString().slice(0, 10)}</time>
        {location && <> · {location}</>}
      </p>
      <Content />
      <p class="now-footnote">
        <small>
          This is a <a href="https://nownownow.com/about" rel="noopener noreferrer">now page</a>.
        </small>
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  .now-meta,
  .now-footnote {
    color: var(--color-muted);
  }
  .placeholder-note {
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-accent);
    border-radius: var(--radius-sm);
    color: var(--color-accent);
  }
</style>
