---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResumeGenerator from '../components/ResumeGenerator.astro';
import ProfileSummary from '../components/ProfileSummary.astro';
import { profile } from '../lib/seo';
---

<BaseLayout title={`Resume Generator | ${profile.contact.name}`} currentPage="/resume">
  <ProfileSummary />
  <!-- Terminal Theme View -->
  <div class="terminal-view">
    <div class="terminal-container">
      <div class="window">
        <div class="terminal">
          <ResumeGenerator />
        </div>
      </div>
    </div>
  </div>

</BaseLayout>
