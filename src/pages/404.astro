---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/ui/Prompt.astro';
import { profile } from '../lib/seo';
---

<BaseLayout title={`Not Found | ${profile.contact.name}`} description="The requested page does not exist." currentPage="/404">
  <Prompt command="ls /requested/path" />
  <div class="output">
    <div class="command-output">ls: cannot access '/requested/path': No such file or directory</div>
  </div>

  <Prompt command="echo fallback.paths" />
  <div class="output link-row">
    <a href="/">/</a>
    <a href="/about">/about</a>
    <a href="/projects">/projects</a>
    <a href="/contact">/contact</a>
  </div>

  <Prompt cursor />
</BaseLayout>
