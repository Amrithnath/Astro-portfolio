---
import BaseLayout from '../shared/layouts/BaseLayout.astro';
import Prompt from '../shared/ui/Prompt.astro';
import Gallery from '../features/photos/Gallery.astro';
import PhotoNav from '../features/photos/PhotoNav.astro';
import { getPhotos, getPublishedCollection } from '../features/content/content';
import { profile } from '../features/seo/seo';
const entries = await getPhotos();
const albums = await getPublishedCollection('albums');
---

<BaseLayout
  title="Photography"
  description={`Photographs by ${profile.contact.name}.`}
  currentPage="/photography"
>
  <h1>Photography</h1><PhotoNav />
  <p><a href="/photography/rss.xml">Photo RSS feed</a></p>
  <Prompt command="ls ~/photography --sort=featured,date" />
  <Gallery entries={entries} albums={albums} filtering />
  <p>
    © {new Date().getFullYear()}
    {profile.contact.name}. All photographs are all rights reserved; please ask before reusing them.
  </p>
</BaseLayout>
