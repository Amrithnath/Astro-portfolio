---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/ui/Prompt.astro';
import Gallery from '../components/photos/Gallery.astro';
import PhotoNav from '../components/photos/PhotoNav.astro';
import { getPhotos, getPublishedCollection } from '../lib/content';
import { profile } from '../lib/seo';
const entries = await getPhotos();
const albums = await getPublishedCollection('albums');
---

<BaseLayout
  title="Photography"
  description={`Photographs by ${profile.contact.name}.`}
  currentPage="/photography"
>
  <h1>Photography</h1><PhotoNav />
  <Prompt command="ls ~/photography --sort=featured,date" />
  <Gallery entries={entries} albums={albums} filtering />
  <p>
    © {new Date().getFullYear()}
    {profile.contact.name}. All photographs are all rights reserved; please ask before reusing them.
  </p>
</BaseLayout>
