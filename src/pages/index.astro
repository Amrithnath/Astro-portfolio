---
import { getProjectPreviews } from '../lib/content';
import { defaultTheme } from '../themes';
// Component Imports
import BaseHead from '../components/BaseHead.astro';
import TerminalShell from '../components/TerminalShell.astro';
import ProfileSummary from '../components/ProfileSummary.astro';
import { profile } from '../lib/seo';
import TerminalView from '../components/TerminalView.astro';
// Dynamic data service
import { generateSeededLandingData } from '../data/landing-data-service';

// Load published project collection entries.
const projects = await getProjectPreviews();

// Generate dynamic data from resume compendium
const dynamicData = generateSeededLandingData();

// Combine projects with dynamic project data
const allProjects = [
  ...projects,
  ...dynamicData.projects.map(project => ({
    frontmatter: {
      title: project.name,
      description: project.description,
      tags: project.technologies,
      demo: project.demo,
      github: project.github,
      type: project.type,
      status: project.status
    },
    url: project.url || project.github || '/projects/',
    title: project.name
  }))
];

// Portfolio data with dynamic content
const portfolioData = {
  title: dynamicData.name,
  description: dynamicData.description,
  projects: allProjects,
  skills: dynamicData.skills,
  techStack: dynamicData.techStack,
  contact: dynamicData.contact,
  achievements: dynamicData.achievements,
  interests: dynamicData.interests,
  stats: dynamicData.stats,
  terminal: dynamicData.terminal,
  currentRole: dynamicData.currentRole
};

---

<!DOCTYPE html>
<html lang="en" data-theme={defaultTheme}>
	<head>
    <BaseHead
      title={`${profile.contact.name} - ${profile.contact.title}`}
      description={profile.summary}
    />
	</head>
    <body>
        <TerminalShell currentPage="/">
          <h1 class="visually-hidden">Amrithnath Vijayakumar</h1>
		  <TerminalView 
			  title={portfolioData.title}
			  description={portfolioData.description}
			  projects={portfolioData.projects}
			  skills={portfolioData.skills}
			  techStack={portfolioData.techStack}
			  contact={portfolioData.contact}
			  achievements={portfolioData.achievements}
			  terminal={portfolioData.terminal}
			  stats={portfolioData.stats}
              renderMode="minimal"
              suppressHeader={true}
              suppressAbout={true}
              suppressBanner={true}
              showFinalCursor={false}
          />
          <ProfileSummary />
        </TerminalShell>


        <!-- Defer full terminal content until after load -->
        <script>
          function initHomepage() {
            const container = document.querySelector<HTMLElement>('#main-content');
            if (location.pathname !== '/' || !container || container.dataset.hydrated) return;
            container.dataset.hydrated = 'true';
            const hydrate = async () => {
              if (!container.isConnected) return;
              try {
                const grid = container.querySelector('.nf-grid');
                const symbols = ['#', '●', '■', '◆', '▣', '▤', '✶', '▓', '@', '%', '&'];
                const seed = (performance.now() | 0) % symbols.length;
                grid?.querySelectorAll('.px:not(.bg)').forEach((el, index) => {
                  el.textContent = symbols[(seed + index * 3) % symbols.length];
                });
                const res = await fetch('/terminal-full/?suppressHeader=1&suppressAbout=1', { credentials: 'same-origin' });
                if (!res.ok || !container.isConnected) return;
                const wrapper = new DOMParser().parseFromString(await res.text(), 'text/html');
                const fragment = wrapper.querySelector('[data-terminal-fragment]');
                if (fragment && container.isConnected) container.appendChild(fragment);
              } catch (error) {
                console.warn('Deferred hydration failed', error);
              }
            };
            // Avoid competing with the initial viewport, including on client-side returns home.
            setTimeout(hydrate, 50);
          }
          if (document.readyState === 'complete') initHomepage();
          else window.addEventListener('load', initHomepage, { once: true });
        </script>
	</body>
</html>
