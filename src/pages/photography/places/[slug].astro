---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import Gallery from '../../../features/photos/Gallery.astro';
import PhotoNav from '../../../features/photos/PhotoNav.astro';
import { getPhotos } from '../../../features/content/content';
import { placeIndex } from '../../../features/photos/photos';
import { geocoderAttribution } from '../../../features/photos/geo';
export async function getStaticPaths() {
  return placeIndex(await getPhotos()).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
---

<BaseLayout
  title={entry.name + ' | Photography'}
  description={'Photographs: ' + entry.name + '.'}
  currentPage={'/photography/places/' + entry.slug}
>
  <h1>{entry.name}</h1><PhotoNav /><Gallery entries={entry.photos} />
  <p class="attribution"><small>{geocoderAttribution}</small></p>
</BaseLayout>
