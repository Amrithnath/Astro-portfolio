---
import BaseLayout from '../../../shared/layouts/BaseLayout.astro';
import Gallery from '../../../features/photos/Gallery.astro';
import PhotoNav from '../../../features/photos/PhotoNav.astro';
import { getPhotos } from '../../../features/content/content';
import { tagIndex } from '../../../features/photos/photos';
export async function getStaticPaths() {
  return tagIndex(await getPhotos()).map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}
const { entry } = Astro.props;
---

<BaseLayout
  title={entry.name + ' | Photography'}
  description={'Photographs: ' + entry.name + '.'}
  currentPage={'/photography/tags/' + entry.slug}
>
  <h1>{entry.name}</h1><PhotoNav /><Gallery entries={entry.photos} />
</BaseLayout>
