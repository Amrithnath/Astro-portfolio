---
import Prompt from '../../shared/ui/Prompt.astro';
import CarbonBadge from './CarbonBadge.astro';
import pkg from '../../../package.json';

export interface Props {
  showCursor?: boolean;
}

const { showCursor = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="terminal-footer">
  <Prompt command={'printf "Thanks for visiting!\\n"'} />
  <div class="output"><div class="command-output">Thanks for visiting!</div></div>

  <Prompt command="uname -srv" />
  <div class="output"><div class="command-output">Astro/Terminal v{pkg.version} — © {year} Amrith — All rights reserved</div></div>

  <Prompt command={'echo "Made with ❤  using Astro"'} />
  <div class="output"><div class="command-output">Made with ❤  using Astro</div></div>

  <CarbonBadge />

  {showCursor && <Prompt cursor />}
</footer>
