---
import Prompt from '../../shared/ui/Prompt.astro';

export interface Props {
  title?: string;
  note?: string;
}
const { title = 'Work In Progress', note = 'This page is under active development. Check back soon.' } = Astro.props;
---

<Prompt command={`echo "${title}"`} />
<div class="output"><div class="command-output">{title}</div></div>

<Prompt command="cat WIP.md" />
<div class="output"><div class="command-output">{note}</div></div>

<Prompt command="ls -la tasks/" />
<div class="output"><div class="command-output">total 4
drwxr-xr-x  2 amrith staff   64 Dec 12 04:20 .
drwxr-xr-x  7 amrith staff  224 Dec 12 04:20 ..
-rw-r--r--  1 amrith staff  256 Dec 12 04:20 backlog.txt
-rw-r--r--  1 amrith staff  128 Dec 12 04:20 todo.md</div></div>

<Prompt command="tail -n 5 tasks/todo.md" />
<div class="output"><div class="command-output">- refine copy
- add screenshots
- verify accessibility
- optimize images
- publish</div></div>

<Prompt command={'echo "Follow progress on /blog"'} />
<div class="output"><div class="command-output">Follow progress on /blog</div></div>

