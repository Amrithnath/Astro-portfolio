---
export interface Props {
  currentPage?: string;
}

const { currentPage = '/' } = Astro.props;

const tabs = [
  { href: '/', title: 'portfolio.sh' },
  { href: '/about', title: 'about.md' },
  { href: '/projects', title: 'projects.json' },
  { href: '/resume', title: 'resume.py' },
  { href: '/blog/', title: 'blog.log' },
  { href: '/privacy-check/', title: 'scan.sh' },
];

const isActive = (href: string) => {
  const path = href.replace(/\/$/, '');
  return path === '' ? currentPage === '/' : currentPage === path || currentPage.startsWith(path + '/');
};
---

<nav class="terminal-tabs" aria-label="Primary">
  {tabs.map(({ href, title }) => {
    const active = isActive(href);
    return (
      <a href={href} class={`tab${active ? ' active' : ''}`} aria-current={active ? 'page' : undefined}>
        <span class="tab-icon" aria-hidden="true">{active ? '●' : '○'}</span>
        <span class="tab-title">{title}</span>
        <span class="tab-close" aria-hidden="true">✕</span>
      </a>
    );
  })}
  <div class="tab-add" aria-hidden="true">+</div>
</nav>
