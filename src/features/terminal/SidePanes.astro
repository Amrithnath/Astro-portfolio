---
// tmux-style side panes that fill the gutters on wide screens (min-width: 110rem); content varies by page.
import { getEntry } from 'astro:content';
import Prompt from '../../shared/ui/Prompt.astro';
import { getPublishedCollection } from '../content/content';
import { resumeCompendium } from '../resume/resume-compendium';
import { careerGraph, nowItems, skillMeters, type PaneContext } from './panes';

export interface Props {
  currentPage?: string;
  title?: string;
  description?: string;
  panes?: PaneContext;
}

const { currentPage = '/', title, description, panes = {} } = Astro.props;
const page = currentPage.replace(/\/$/, '').split('/').filter(Boolean).at(-1) ?? 'portfolio';
const name = panes.name ?? `${page} - ${(title ?? '').split(' | ')[0] || 'terminal portfolio'}`;
const summary = panes.description ?? description;
const sections = panes.sections ?? [];
const seeAlso = panes.seeAlso ?? [];

// Photography routes are unlisted, so only they show (and link to) photography content.
const photography = currentPage.startsWith('/photography');
const contact = resumeCompendium.contact;
const career = photography ? [] : careerGraph(resumeCompendium, panes.focusDate);
const skills = skillMeters(resumeCompendium, { focus: panes.skills, all: panes.allSkills });
const nowEntry = await getEntry('now', 'now');
const now = nowItems(nowEntry?.body, nowEntry?.data.placeholder ?? true);

const [albums, photos] = photography
  ? await Promise.all([
      getPublishedCollection('albums'),
      getPublishedCollection('photos').then(entries =>
        entries.sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)).slice(0, 5)
      ),
    ])
  : [[], []];

const bar = (percent: number) => {
  const filled = Math.round(percent / 10);
  return `${'|'.repeat(filled)}${' '.repeat(10 - filled)}`;
};
const host = (value?: string) => value?.replace(/^https?:\/\//, '');

// [data-metric, label, has a good/okay/slow verdict]; values are filled in by the script below.
const perfRows: [string, string, boolean][] = [
  ['ttfb', 'server reply', true],
  ['fcp', 'first paint', true],
  ['lcp', 'main content', true],
  ['cls', 'layout shift', true],
  ['requests', 'files loaded', false],
  ['transferred', 'downloaded', false],
  ['dom', 'page elements', false],
  ['heap', 'JS memory', false],
  ['uptime', 'time on page', false],
];
const perfHelp: [string, string][] = [
  ['server reply', 'How long the server took to start answering (time to first byte).'],
  ['first paint', 'When anything first appeared on screen (First Contentful Paint).'],
  ['main content', 'When the biggest text or image finished drawing (Largest Contentful Paint).'],
  ['layout shift', 'How much things jumped around while loading; lower is better (Cumulative Layout Shift).'],
  ['fast / okay / slow', "Google's Core Web Vitals thresholds for a good experience."],
  ['downloaded', 'Data sent over the network for this page; files already in your cache count as 0.'],
  ['JS memory', 'Memory used by scripts on this page (Chromium browsers only).'],
  ['this page', 'CO₂ for the data this page view moved, using the Sustainable Web Design model and the global average grid.'],
  ['first visit', 'The same page with nothing cached. Grades run from A+ (cleanest) to F.'],
  ['this visit', 'Running total for every page you have opened in this tab.'],
];
---

<aside class="side-pane side-pane-left" aria-label="Page manual and career">
  <div class="pane-label" aria-hidden="true">0:man</div>
  <Prompt command={`man ./${page}`} />
  <dl class="man-page">
    <dt>NAME</dt>
    <dd>{name}</dd>
    {panes.synopsis && <><dt>SYNOPSIS</dt><dd>{panes.synopsis}</dd></>}
    {summary && <><dt>DESCRIPTION</dt><dd class="man-description">{summary}</dd></>}
    {sections.length > 0 && (
      <>
        <dt>SECTIONS</dt>
        <dd>
          <ul class="pane-list">
            {sections.map(({ href, label, depth = 2 }) => (
              <li style={depth > 2 ? `--depth: ${depth - 2}` : undefined}><a href={href}>{label}</a></li>
            ))}
          </ul>
        </dd>
      </>
    )}
    {seeAlso.length > 0 && (
      <>
        <dt>SEE ALSO</dt>
        <dd>
          <ul class="pane-list">
            {seeAlso.map(({ href, label }) => <li><a href={href}>{label}</a></li>)}
          </ul>
        </dd>
      </>
    )}
  </dl>

  {photography ? (
    <>
      <Prompt command="ls ~/photography/albums" />
      <ul class="pane-list">
        {albums.map(album => (
          <li><a href={`/photography/albums/${album.id}/`}>{album.data.title}/</a></li>
        ))}
        <li><a href="/photography/places/">places/</a></li>
        <li><a href="/photography/tags/">tags/</a></li>
      </ul>
    </>
  ) : (
    <>
      <Prompt command="git log --graph ~/career" />
      <ol class="career-graph">
        {career.map((commit, i) => (
          <li class:list={{ focused: commit.focused }}>
            <span class="graph-rail" aria-hidden="true">*</span>
            <div>
              <span class="commit-date">
                <time datetime={commit.start}>{commit.start}</time>
                {commit.end ? <> → <time datetime={commit.end}>{commit.end}</time></> : ' → now'}
              </span>
              {commit.head && <span class="commit-ref"> (HEAD -&gt; main)</span>}
              {commit.focused && <span class="commit-ref"> (written here)</span>}
              <span class="commit-title">{commit.title}</span>
              <span class="commit-org">{commit.org}</span>
              {panes.expandCareer && commit.technologies.length > 0 && (
                <span class="commit-tech">{commit.technologies.join(' · ')}</span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </>
  )}
</aside>

<aside class="side-pane side-pane-right" aria-label="Profile and skills">
  <div class="pane-label" aria-hidden="true">1:whoami</div>
  {photography ? (
    <>
      <Prompt command="ls -t ~/photography | head -5" />
      <ul class="pane-list">
        {photos.map(photo => (
          <li>
            <a href={`/photography/${photo.id}/`}>{photo.data.title}</a>
            {photo.data.location?.name && <span class="pane-muted"> — {photo.data.location.name}</span>}
          </li>
        ))}
      </ul>
    </>
  ) : (
    <>
      <Prompt command="neofetch --short" />
      <dl class="pane-fetch">
        <dt class="pane-fetch-title">{contact.name.split(' ')[0].toLowerCase()}@portfolio</dt>
        <dd class="pane-fetch-rule" aria-hidden="true">{'-'.repeat(18)}</dd>
        <dt>Role</dt><dd>{contact.title}</dd>
        {contact.location && <><dt>Location</dt><dd>{contact.location}</dd></>}
        <dt>Mail</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
        {contact.github && <><dt>GitHub</dt><dd><a href={`https://${host(contact.github)}`}>{host(contact.github)?.replace('github.com/', '')}</a></dd></>}
        {contact.linkedin && <><dt>LinkedIn</dt><dd><a href={`https://${host(contact.linkedin)}`}>{host(contact.linkedin)?.replace('linkedin.com/in/', '')}</a></dd></>}
      </dl>
    </>
  )}

  <div class="perf-mon" data-perf-mon hidden>
    <Prompt command="top -p $$" />
    <p class="pane-muted pane-caption"># how this page loaded for you</p>
    <dl class="pane-stats">
      {perfRows.map(([metric, label, rated]) => (
        <>
          <dt data-metric-label={metric}>{label}</dt>
          <dd data-metric-row={metric}>
            <span data-metric={metric}>n/a</span>
            {rated && <span class="perf-rating" data-rating={metric}></span>}
          </dd>
        </>
      ))}
    </dl>
    <Prompt command="carbon --estimate --live" />
    <p class="pane-muted pane-caption"># CO₂ from data sent to you</p>
    <dl class="pane-stats">
      <dt>this page</dt><dd data-metric="co2-view">n/a</dd>
      <dt>first visit</dt><dd data-metric="co2-cold">n/a</dd>
      <dt>this visit</dt><dd data-metric="co2-session">n/a</dd>
    </dl>
    <details class="pane-help">
      <summary>what do these mean?</summary>
      <dl>
        {perfHelp.map(([term, text]) => <><dt>{term}</dt><dd>{text}</dd></>)}
      </dl>
    </details>
  </div>

  <Prompt command={panes.allSkills ? 'htop --tree' : 'htop'} />
  <div class="htop">
    {skills.map(group => (
      <section aria-label={group.category}>
        <p class="htop-group">{group.category}</p>
        <ul class="pane-list">
          {group.meters.map(skill => (
            <li class="htop-row">
              <span class="htop-name">{skill.name}</span>
              <span class="htop-bar" role="img" aria-label={`${skill.name}: ${skill.level}${skill.years ? `, ${skill.years} years` : ''}`}>[<span class:list={['htop-fill', `level-${skill.level}`]}>{bar(skill.percent)}</span>]{skill.years ? ` ${String(skill.years).padStart(2)}y` : ''}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  {now.length > 0 && (
    <>
      <Prompt command="tail -f ~/.now" />
      <dl class="now-log">
        {now.map(item => <><dt>{item.heading}</dt><dd>{item.text}</dd></>)}
      </dl>
    </>
  )}
</aside>

<script>
  import { carbonEstimate, formatBytes, formatMs, rateMetric, transferTotals, type RatedMetric } from './perf';

  const root = document.querySelector<HTMLElement>('[data-perf-mon]');
  if (root && !root.dataset.ready) {
    root.dataset.ready = 'true';
    root.hidden = false;
    const wide = window.matchMedia('(min-width: 110rem)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sessionKey = 'portfolio-session-bytes';
    const set = (name: string, value: string) => {
      const element = root.querySelector<HTMLElement>(`[data-metric="${name}"]`);
      if (element && element.textContent !== value) element.textContent = value;
    };
    const rate = (metric: RatedMetric, value: number | undefined) => {
      const element = root.querySelector<HTMLElement>(`[data-rating="${metric}"]`);
      const verdict = rateMetric(metric, value);
      if (!element) return;
      const text = verdict ? `· ${verdict.word}` : '';
      if (element.textContent !== text) element.textContent = text;
      if (verdict) element.dataset.level = verdict.rating;
      else delete element.dataset.level;
    };
    const readSession = () => {
      try {
        return Number(sessionStorage.getItem(sessionKey)) || 0;
      } catch {
        return 0;
      }
    };
    let previousPages = readSession();
    const co2 = (bytes: number) => {
      const { grams, rating } = carbonEstimate(bytes);
      return `${grams.toFixed(grams < 0.01 ? 4 : 3)} g (${rating})`;
    };

    let lcp: number | undefined;
    let cls = 0;
    const observe = (type: string, onEntry: (entry: PerformanceEntry) => void) => {
      try {
        new PerformanceObserver(list => list.getEntries().forEach(onEntry)).observe({ type, buffered: true });
      } catch {
        // Unsupported entry type: the metric stays n/a.
      }
    };
    observe('largest-contentful-paint', entry => (lcp = entry.startTime));
    observe('layout-shift', entry => {
      const shift = entry as PerformanceEntry & { value: number; hadRecentInput: boolean };
      if (!shift.hadRecentInput) cls += shift.value;
    });

    const memory = (performance as Performance & { memory?: { usedJSHeapSize: number } }).memory;
    if (!memory) {
      root.querySelector('[data-metric-label="heap"]')?.remove();
      root.querySelector('[data-metric-row="heap"]')?.remove();
    }

    let transferred = 0;
    const render = () => {
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const paint = performance.getEntriesByName('first-contentful-paint')[0];
      const totals = transferTotals(navigation ? [navigation, ...resources] : resources);
      transferred = totals.transferred;
      set('ttfb', formatMs(navigation?.responseStart));
      set('fcp', formatMs(paint?.startTime));
      set('lcp', formatMs(lcp));
      set('cls', cls.toFixed(3));
      rate('ttfb', navigation?.responseStart);
      rate('fcp', paint?.startTime);
      rate('lcp', lcp);
      rate('cls', navigation ? cls : undefined);
      set('requests', String(resources.length + (navigation ? 1 : 0)));
      set('transferred', formatBytes(totals.transferred));
      set('dom', String(document.getElementsByTagName('*').length));
      if (memory) set('heap', formatBytes(memory.usedJSHeapSize));
      set('uptime', `${Math.floor(performance.now() / 1000)} s`);
      set('co2-view', co2(totals.transferred));
      set('co2-cold', co2(totals.firstVisit));
      set('co2-session', co2(previousPages + totals.transferred));
    };

    let timer: number | undefined;
    const schedule = () => {
      window.clearInterval(timer);
      timer = undefined;
      render();
      if (wide.matches && !reducedMotion.matches && document.visibilityState === 'visible') {
        timer = window.setInterval(render, 1000);
      }
    };
    wide.addEventListener('change', schedule);
    reducedMotion.addEventListener('change', schedule);
    document.addEventListener('visibilitychange', schedule);
    window.addEventListener('load', schedule);
    window.addEventListener('pagehide', () => {
      render();
      try {
        sessionStorage.setItem(sessionKey, String(previousPages + transferred));
      } catch {
        // Storage blocked: the session total restarts on each page.
      }
    });
    // Back/forward cache restores already counted this page; rebase on later pages' totals.
    window.addEventListener('pageshow', event => {
      if (event.persisted) previousPages = Math.max(0, readSession() - transferred);
      schedule();
    });
    schedule();
  }
</script>
