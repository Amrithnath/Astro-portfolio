---
// Anonymous article view count from the views Worker (workers/views/). Rendered only when
// PUBLIC_VIEWS_URL is set at build time. The line keeps its space while hidden, so loading or
// failing never shifts layout. Each browser increments a path at most once (localStorage flag),
// only on the production hostname, and never when GPC/DNT is on; otherwise it just reads.
interface Props {
  path: string;
}

const path = Astro.props.path.replace(/\/?$/, '/');
const configured = import.meta.env.PUBLIC_VIEWS_URL?.trim().replace(/\/+$/, '');
const endpoint = (() => {
  if (!configured) return undefined;
  try {
    const url = new URL(`${configured}/views`);
    return url.protocol === 'https:' || url.hostname === 'localhost' ? url.href : undefined;
  } catch {
    return undefined;
  }
})();
const host = new URL(Astro.site ?? 'https://amrithnath.dev').hostname;
---

{
  endpoint && (
    <p class="view-count" data-view-count data-endpoint={endpoint} data-path={path} data-host={host}>
      <span class="view-count-label">views:</span> <span data-view-count-value>0</span>
    </p>
  )
}

<script>
  const numberFormat = new Intl.NumberFormat('en');

  const load = async (element: HTMLElement) => {
    const { endpoint, path, host } = element.dataset;
    if (!endpoint || !path) return;
    const key = `portfolio-viewed:${path}`;
    let seen = false;
    try {
      seen = localStorage.getItem(key) === '1';
    } catch {
      seen = true;
    }
    const optedOut =
      (navigator as Navigator & { globalPrivacyControl?: boolean }).globalPrivacyControl === true ||
      navigator.doNotTrack === '1';
    const increment = !seen && !optedOut && location.hostname === host;

    try {
      const response = increment
        ? await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path }),
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          })
        : await fetch(`${endpoint}?path=${encodeURIComponent(path)}`, {
            credentials: 'omit',
            referrerPolicy: 'no-referrer',
          });
      if (!response.ok) return;
      const { count } = await response.json();
      if (!Number.isSafeInteger(count) || count < 0) return;
      if (increment) {
        try {
          localStorage.setItem(key, '1');
        } catch {}
      }
      const value = element.querySelector('[data-view-count-value]');
      if (!value) return;
      value.textContent = numberFormat.format(count);
      element.dataset.loaded = '';
    } catch {}
  };

  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-view-count]').forEach(element => {
      if (element.dataset.viewCountInit) return;
      element.dataset.viewCountInit = '1';
      void load(element);
    });
  };
  init();
</script>

<style>
  .view-count {
    margin-block: var(--space-2) 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    visibility: hidden;
  }

  .view-count[data-loaded] {
    visibility: visible;
  }

  .view-count-label {
    color: var(--color-accent);
  }
</style>
