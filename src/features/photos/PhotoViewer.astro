---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import PhotoImage from './PhotoImage.astro';
import { remoteImage } from './photos';
import { derivativeWidths } from './config';
interface Props { photo: CollectionEntry<'photos'> }
const { photo } = Astro.props;
const { image, remote, title, alt } = photo.data;
const detail = remote ? remoteImage(remote).src : image ? (await getImage({
  src: image,
  width: Math.min(derivativeWidths.at(-1)!, image.width),
  format: 'webp',
})).src : '';
---
<div data-photo-viewer data-detail={detail}>
  <PhotoImage photo={photo} eager priority />
  <button type="button" data-open hidden aria-haspopup="dialog">Open full-screen photo</button>
  <dialog aria-labelledby="photo-viewer-title" aria-describedby="photo-viewer-help">
    <header>
      <h2 id="photo-viewer-title">{title}</h2>
      <button type="button" data-close autofocus aria-label="Close photo viewer">Close (Esc)</button>
    </header>
    <div data-stage role="img" aria-label={alt}>
      <img data-preview alt="" draggable="false" />
      <canvas hidden aria-hidden="true"></canvas>
    </div>
    <footer>
      <div role="group" aria-label="Photo zoom controls">
        <button type="button" data-zoom-out aria-label="Zoom out">−</button>
        <output data-scale aria-live="polite" aria-label="Zoom level">100%</output>
        <button type="button" data-zoom-in aria-label="Zoom in">+</button>
        <button type="button" data-reset>Fit (0)</button>
      </div>
      <p id="photo-viewer-help">Scroll or pinch to zoom; drag to pan. Double-click or double-tap to zoom.
        Keys: + / −, 0 to fit, arrows to pan, Esc to close.</p>
      <p data-status role="status"></p>
    </footer>
  </dialog>
</div>
<script>
  const root = document.querySelector<HTMLElement>('[data-photo-viewer]');
  if (root) {
    const opener = root.querySelector<HTMLButtonElement>('[data-open]')!;
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const preview = root.querySelector<HTMLImageElement>('[data-preview]')!;
    const display = root.querySelector<HTMLImageElement>('picture img')!;
    let cleanup: (() => void) | undefined;
    let session = 0;
    let overflow = '';
    opener.hidden = false;
    opener.addEventListener('click', async () => {
      if (dialog.open) return;
      const current = ++session;
      preview.src = display.currentSrc || display.src;
      preview.style.transform = '';
      preview.style.width = '';
      preview.style.height = '';
      root.querySelector<HTMLCanvasElement>('canvas')!.hidden = true;
      root.querySelector<HTMLOutputElement>('[data-scale]')!.value = '100%';
      root.querySelector<HTMLElement>('[data-status]')!.textContent = 'Loading detail…';
      overflow = document.documentElement.style.overflow;
      document.documentElement.style.overflow = 'hidden';
      dialog.showModal();
      try {
        const { createViewer } = await import('./photo-viewer');
        if (dialog.open && current === session) cleanup = createViewer(root, dialog);
      } catch {
        if (dialog.open && current === session) {
          root.querySelector<HTMLElement>('[data-status]')!.textContent =
            'Interactive zoom is unavailable. The photo is still visible.';
        }
      }
    });
    root.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      ++session;
      cleanup?.();
      cleanup = undefined;
      document.documentElement.style.overflow = overflow;
      opener.focus({ preventScroll: true });
    });
  }
</script>
<style>
  [data-open] { margin-top: var(--space-3); }
  dialog {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: var(--space-3);
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
  }
  dialog[open] { display: flex; flex-direction: column; gap: var(--space-2); }
  dialog::backdrop { background: var(--color-bg); }
  header { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  h2 { font-size: var(--text-lg); margin: 0; }
  button { min-width: 44px; min-height: 44px; }
  [data-stage] {
    position: relative;
    flex: 1;
    min-height: 80px;
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    user-select: none;
  }
  [data-stage]:active { cursor: grabbing; }
  [data-preview] {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  [role='group'] { display: flex; align-items: center; justify-content: center; gap: var(--space-3); }
  footer p { font-size: var(--text-xs); margin: var(--space-1) 0 0; }
  [data-status]:empty { display: none; }
  @media (prefers-reduced-motion: reduce) {
    dialog, dialog * { animation: none !important; transition: none !important; }
  }
</style>
