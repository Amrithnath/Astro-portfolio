---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import { contentPath, getPublishedCollection, getProjectWriteups } from './content';
import type { PaneContext } from '../terminal/panes';
import BaseLayout from '../../shared/layouts/BaseLayout.astro';
import Prompt from '../../shared/ui/Prompt.astro';
import Button from '../../shared/ui/Button.astro';
import Card from '../../shared/ui/Card.astro';
import ViewCount from '../views/ViewCount.astro';
import type { Props as SEOProps } from '../seo/SEO.astro';

interface Props {
  content: Record<string, any>;
  schemaType: SEOProps['schemaType'];
  headings?: MarkdownHeading[];
}

const { content, schemaType, headings = [] } = Astro.props;
const imageSource = content.img || content.image;
const isProject = schemaType === 'SoftwareSourceCode';
const currentId = Astro.url.pathname.replace(/^\/(?:blog|project)\//, '').replace(/\/$/, '');
const writeups = isProject ? await getProjectWriteups(currentId) : [];
const project = content.project?.id
  ? (await getPublishedCollection('projects')).find(entry => entry.id === content.project.id)
  : undefined;
const projectWriteups = project ? await getProjectWriteups(project.id) : [];
const projectTech = content.tech?.length ? content.tech : content.tags || [];
const projectLinks = isProject
  ? [
      ['GitHub', content.github],
      ['Live', content.live],
      ['Demo', content.demo],
      ['Project link', content.link],
    ].filter((item): item is [string, string] => Boolean(item[1]))
  : [];
const panes: PaneContext = {
  name: `${currentId.split('/').at(-1)} - ${content.title}`,
  synopsis: [content.pubDate.toISOString().slice(0, 10), ...(content.tags ?? []).map((tag: string) => `#${tag}`)].join(' '),
  description: content.description,
  sections: headings
    .filter(heading => heading.depth <= 3)
    .map(heading => ({ href: `#${heading.slug}`, label: heading.text, depth: heading.depth })),
  seeAlso: [
    ...(project ? [{ href: `${contentPath(project)}/`, label: `project: ${project.data.title}` }] : []),
    ...[...writeups, ...projectWriteups]
      .filter(post => contentPath(post) !== Astro.url.pathname.replace(/\/$/, ''))
      .map(post => ({ href: `${contentPath(post)}/`, label: post.data.title })),
    isProject ? { href: '/projects', label: 'projects(1)' } : { href: '/blog/', label: 'blog(1)' },
  ],
  skills: projectTech,
  focusDate: content.pubDate,
};
const viewsEnabled = Boolean(import.meta.env.PUBLIC_VIEWS_URL);
const formatDate = (date: Date) => new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' }).format(date);
---

<BaseLayout
  title={content.title}
  description={content.description}
  lang={content.lang || 'en'}
  currentPage={Astro.url.pathname}
  type="article"
  schemaType={schemaType}
  published={content.pubDate}
  modified={content.updatedDate}
  keywords={content.tags}
  projectUrl={content.link || content.live || content.demo || content.github}
  panes={panes}
>
  <Prompt path="~/articles" command={`cat ${Astro.url.pathname.replace(/\/$/, '')}.md`} />
  <article class="prose">
    <header>
      <h1>{content.title}</h1>
      <p>{content.description}</p>
      {viewsEnabled && <ViewCount path={Astro.url.pathname} />}
      {isProject && (
        <p class="article-status">
          <span class="card-label">Status</span>{' '}
          <span class="status-badge" data-status={content.status || 'unspecified'}>{content.status || 'Status not specified'}</span>
          {content.featured && <span class="status-badge">Featured</span>}
        </p>
      )}
      {projectTech.length > 0 && (
        <ul class="tag-list" aria-label={isProject ? 'Technologies' : 'Tags'}>
          {projectTech.map((tag: string) => <li>#{tag}</li>)}
        </ul>
      )}
      {!isProject && content.tags?.length > 0 && !projectTech.length && (
        <ul class="tag-list" aria-label="Tags">
          {content.tags.map((tag: string) => <li>{tag}</li>)}
        </ul>
      )}
      {imageSource && (
        <Image
          src={imageSource}
          width={1400}
          height={700}
          widths={[400, 800, 1400]}
          sizes="(max-width: 48rem) calc(100vw - 1.5rem), 72ch"
          format="avif"
          loading="eager"
          fetchpriority="high"
          alt={content.title}
        />
      )}
      {isProject && projectLinks.length > 0 && (
        <div class="link-row" aria-label="Project links">
          {projectLinks.map(([label, href]) => (
            <Button href={href} target="_blank" rel="noopener noreferrer">{label}</Button>
          ))}
        </div>
      )}
      {!isProject && project && (
        <p class="project-relationship">
          Part of project: <a href={`/project/${project.id}/`}>{project.data.title}</a>
        </p>
      )}
    </header>
    <div class="article-body"><slot /></div>
    {isProject && (
      <section class="related-content" aria-labelledby="writeups-title">
        <h2 id="writeups-title">Write-ups</h2>
        {writeups.length > 0 ? (
          <ul class="related-list">
            {writeups.map(post => (
              <li>
                <Card href={`/blog/${post.id}/`}>
                  <span class="card-title">{post.data.title}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>{post.data.description}</span>
                </Card>
              </li>
            ))}
          </ul>
        ) : <p>No write-ups are linked to this project yet.</p>}
      </section>
    )}
    {!isProject && project && (
      <section class="related-content" aria-labelledby="more-writeups-title">
        <h2 id="more-writeups-title">More write-ups on this project</h2>
        {projectWriteups.filter(post => post.id !== currentId).length > 0 ? (
          <ul class="related-list">
            {projectWriteups.filter(post => post.id !== currentId).map(post => (
              <li>
                <Card href={`/blog/${post.id}/`}>
                  <span class="card-title">{post.data.title}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>{post.data.description}</span>
                </Card>
              </li>
            ))}
          </ul>
        ) : <p>This is the only write-up linked to this project so far.</p>}
      </section>
    )}
    <footer>
      {schemaType === 'BlogPosting' ? (
        <>
          <p class="content-license">
            This post is licensed under{' '}
            <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.
          </p>
          <p><a href="/blog/">View more posts</a></p>
        </>
      ) : (
        <p><a href="/projects/">View more projects</a></p>
      )}
    </footer>
  </article>
  <style>
    .article-status { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
    .status-badge { padding: 0.1rem 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); color: var(--color-accent); font-size: var(--text-sm); }
    .related-content { margin-block: var(--space-6); }
    .related-list { display: grid; gap: var(--space-3); padding: 0; list-style: none; }
    .related-list time { color: var(--color-muted); font-size: var(--text-sm); }
    .project-relationship { margin-top: var(--space-3); }
  </style>
</BaseLayout>
