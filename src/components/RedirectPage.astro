---
import SEO from './SEO.astro';
const { to } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <SEO title="Redirecting" description="This page has moved." noindex />
  </head>
  <body><p><a href={to}>Continue to the destination page</a></p></body>
</html>
