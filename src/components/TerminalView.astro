---
import Prompt from './ui/Prompt.astro';
import TerminalCommands from './TerminalCommands.astro';
import { getProjectItems } from '../data/navigation.ts';

// Terminal content: the neofetch landing view, the deferred command fragment, or both.
export interface Props {
  title?: string;
  description?: string;
  projects?: any[];
  skills?: string[];
  techStack?: { [category: string]: string[] };
  contact?: {
    email?: string;
    github?: string;
    linkedin?: string;
  };
  achievements?: string[];
  terminal?: {
    recentCommands?: string[];
    systemInfo?: {
      uptime?: string;
      load?: string;
      processes?: number;
    };
  };
  stats?: {
    projectsCompleted?: number;
    technologiesUsed?: number;
    yearsOfExperience?: number;
    certifications?: number;
    awards?: number;
  };
  renderMode?: 'full' | 'minimal';
  fragmentOnly?: boolean;
  suppressHeader?: boolean;
  suppressAbout?: boolean;
  suppressBanner?: boolean;
  showFinalCursor?: boolean;
}

const {
  title = 'Amrithnath Vijayakumar',
  description = 'Senior Engineer, gamer, and photographer',
  projects = [],
  techStack = {},
  contact = {},
  achievements = [],
  terminal = {},
  stats = {},
  renderMode = 'full',
  fragmentOnly = false,
  suppressHeader = false,
  suppressAbout = false,
  showFinalCursor = true,
} = Astro.props;

const projectItems = getProjectItems(projects);
const randomAchievement = achievements.length > 0
  ? achievements[Math.floor(Math.random() * achievements.length)]
  : 'Building innovative solutions';

type TreeNode = { name: string; type: 'file' | 'directory'; extension?: string; children?: TreeNode[] };

const defaultSkills: Record<string, string[]> = {
  'frontend/': ['javascript.js', 'typescript.ts', 'react.jsx', 'nextjs.js', 'astro.astro', 'vue.vue'],
  'backend/': ['nodejs.js', 'python.py', 'django.py', 'express.js', 'fastapi.py'],
  'database/': ['postgresql.sql', 'mongodb.js', 'redis.conf', 'sqlite.db'],
  'devops/': ['docker.yml', 'aws.tf', 'cicd.yml', 'git.config', 'vercel.json'],
};

function getSkillExtension(skill: string): string {
  const s = skill.toLowerCase();
  if (s.includes('javascript') || s.includes('js') || s.includes('react') || s.includes('vue') || s.includes('angular')) return 'js';
  if (s.includes('typescript') || s.includes('ts')) return 'ts';
  if (s.includes('python') || s.includes('django') || s.includes('fastapi')) return 'py';
  if (s.includes('sql') || s.includes('postgres') || s.includes('mysql')) return 'sql';
  if (s.includes('json')) return 'json';
  if (s.includes('yaml') || s.includes('yml')) return 'yml';
  if (s.includes('markdown') || s.includes('md')) return 'md';
  if (s.includes('astro')) return 'astro';
  return 'conf';
}

function convertTechStackToTreeItems(stack: { [category: string]: string[] }): TreeNode[] {
  if (Object.keys(stack).length === 0) {
    return Object.entries(defaultSkills).map(([name, files]) => ({
      name,
      type: 'directory',
      children: files.map((file) => ({ name: file, type: 'file', extension: file.split('.').pop() })),
    }));
  }
  return Object.entries(stack).map(([category, skillList]) => ({
    name: `${category.toLowerCase().replace(/\s+/g, '-')}/`,
    type: 'directory',
    children: skillList.map((skill) => ({
      name: `${skill.toLowerCase().replace(/\s+/g, '-')}.${getSkillExtension(skill)}`,
      type: 'file',
      extension: getSkillExtension(skill),
    })),
  }));
}

const skillsTreeItems = convertTechStackToTreeItems(techStack);
const totalDirs = skillsTreeItems.length;
const totalFiles = skillsTreeItems.reduce((total, dir) => total + (dir.children?.length || 0), 0);

// Pixel-grid ASCII banner: each letter is a 5x7 bitmap drawn with rotating glyphs.
const ASCII_ROWS = 7;
const ASCII_COLS = 5;
const LETTER_SPACING = 1;
const letterPatterns: Record<string, string[]> = {
  A: ['01110', '10001', '10001', '11111', '10001', '10001', '10001'],
  M: ['10001', '11011', '10101', '10001', '10001', '10001', '10001'],
  R: ['11110', '10001', '10001', '11110', '10100', '10010', '10001'],
  I: ['11111', '00100', '00100', '00100', '00100', '00100', '11111'],
  T: ['11111', '00100', '00100', '00100', '00100', '00100', '00100'],
  H: ['10001', '10001', '10001', '11111', '10001', '10001', '10001'],
};

function buildAsciiGrid(name: string) {
  const text = name.toUpperCase();
  let colOffset = 1;
  const colors = ['c-cyan', 'c-purple', 'c-green', 'c-blue', 'c-yellow', 'c-red', 'c-cyan'];
  const symbolsBase = ['#', '●', '■', '◆', '▣', '▤', '✶', '▓', '@', '%', '&'];
  const startSeed = Date.now() % 97;
  const symbols = symbolsBase.slice(startSeed % symbolsBase.length).concat(symbolsBase.slice(0, startSeed % symbolsBase.length));
  const cells: { row: number; col: number; color: string; ch: string }[] = [];
  for (const ch of text) {
    const pattern = letterPatterns[ch] || letterPatterns['I'];
    for (let r = 0; r < ASCII_ROWS; r++) {
      for (let c = 0; c < ASCII_COLS; c++) {
        if (pattern[r][c] === '1') {
          const sym = symbols[(startSeed + r * 7 + c * 3 + colOffset) % symbols.length];
          cells.push({ row: r + 1, col: colOffset + c, color: colors[r % colors.length], ch: sym });
        }
      }
    }
    colOffset += ASCII_COLS + LETTER_SPACING;
  }
  return { cells, totalCols: colOffset - LETTER_SPACING };
}

const commandProps = {
  title,
  description,
  randomAchievement,
  stats,
  contact,
  terminal,
  projectItems,
  skillsTreeItems,
  totalDirs,
  totalFiles,
};
const lastLogin = new Date().toLocaleDateString('en-US', {
  weekday: 'short',
  month: 'short',
  day: 'numeric',
  hour: '2-digit',
  minute: '2-digit',
});
---

{fragmentOnly ? (
  <TerminalCommands {...commandProps} />
) : (
  <>
    {!suppressHeader && (
      <>
        <div class="command-output">Last login: {lastLogin} on ttys000</div>
        <Prompt command="whoami" />
        <div class="output"><div class="command-output">amrith</div></div>
      </>
    )}

    {renderMode === 'minimal' && (
      <>
        <Prompt user="root" host="boot" path="/usr/bin" command="/sbin/init --system" />
        <div class="output"><div class="command-output">[  OK  ] Started terminal environment.</div></div>

        <Prompt user="root" host="boot" path="/usr/bin" command="login amrith" />
        <div class="output"><div class="command-output">Welcome, amrith</div></div>

        <Prompt command="neofetch" />
        <div class="output">
          <div class="neofetch">
            {(() => {
              const grid = buildAsciiGrid('AMRITH');
              return (
                <div class="nf-ascii nf-grid" style={`--cols:${grid.totalCols};--px:16px;`} role="img" aria-label="AMRITH ASCII">
                  {Array.from({ length: 7 * grid.totalCols }).map((_, i) => {
                    const row = Math.floor(i / grid.totalCols) + 1;
                    const col = (i % grid.totalCols) + 1;
                    const fg = grid.cells.find((c) => c.row === row && c.col === col);
                    if (fg) {
                      return <span class={`px ${fg.color}`} style={`grid-row:${row};grid-column:${col};`}>{fg.ch}</span>;
                    }
                    const bgCh = ['·', '•', '+', '∙', '⋅'][i % 5];
                    const bgColor = ['c-blue', 'c-purple', 'c-cyan', 'c-green'][row % 4];
                    return <span class={`px bg ${bgColor}`} style={`grid-row:${row};grid-column:${col};`}>{bgCh}</span>;
                  })}
                </div>
              );
            })()}
            <div class="nf-name">TECHNOLOGIST</div>
            <div class="nf-row"><span class="nf-key k-cyan">Role</span><span class="nf-sep">:</span><span class="nf-value v-cyan">Senior Engineer</span> <span class="nf-sep">•</span> <span class="nf-value v-purple">HCP Core Platform</span></div>
            <div class="nf-row"><span class="nf-key k-green">Focus</span><span class="nf-sep">:</span><span class="nf-value v-green">Astro</span> <span class="nf-sep">•</span> <span class="nf-value v-blue">TypeScript</span> <span class="nf-sep">•</span> <span class="nf-value v-yellow">AWS</span></div>
            <div class="nf-row"><span class="nf-key k-magenta">About</span><span class="nf-sep">:</span><span class="nf-value v-fg">{description}</span></div>
          </div>
        </div>

        <Prompt command="uptime" />
        <div class="output"><div class="command-output">up {terminal.systemInfo?.uptime || '321 days'}, load {terminal.systemInfo?.load || '0.95 0.23 1.83'}</div></div>

        <Prompt command="echo $TECH_STACK | tr ':' '\n'" />
        <div class="output"><div class="command-output">JavaScript
TypeScript
Node.js
Astro
AWS
Docker</div></div>
        <Prompt />
      </>
    )}

    {renderMode === 'full' && !suppressAbout && <TerminalCommands {...commandProps} withIntro />}

    {showFinalCursor && <Prompt cursor />}
  </>
)}
