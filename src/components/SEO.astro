---
import { ogImagePath, ogWidth, ogHeight } from '../lib/og';
import {
  isIndexablePath,
  pageDescriptions,
  personSchema,
  profile,
  serializeJsonLd,
} from '../lib/seo';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  type?: 'website' | 'article';
  schemaType?: 'BlogPosting' | 'SoftwareSourceCode' | 'CreativeWork';
  published?: string | Date;
  modified?: string | Date;
  keywords?: string[];
  projectUrl?: string;
  markdown?: string;
}

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const {
  title = `${profile.contact.name} | ${profile.contact.title}`,
  description = pageDescriptions[path] || profile.summary,
  image = ogImagePath(path),
  imageWidth = image.startsWith('/og/') ? ogWidth : undefined,
  imageHeight = image.startsWith('/og/') ? ogHeight : undefined,
  noindex = !isIndexablePath(path),
  type = 'website',
  schemaType,
  published,
  modified,
  keywords,
  projectUrl,
  markdown = isIndexablePath(path)
    ? ['/', '/about', '/resume', '/projects'].includes(path)
      ? `${path === '/' ? '/index' : path}.md`
      : schemaType ? `${path}.md` : undefined
    : undefined,
} = Astro.props;
const site = Astro.site!;
const canonical = new URL(path === '/' ? '/' : `${path}/`, site).href;
const imageUrl = new URL(image, site).href;
const pageTitle = title.includes(profile.contact.name) ? title : `${title} | ${profile.contact.name}`;
const person = personSchema(site);
const websiteId = new URL('/#website', site).href;
const pageId = `${canonical}#webpage`;
const graph: Record<string, unknown>[] = [
  person,
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: site.href,
    name: `${profile.contact.name}'s portfolio`,
    description: profile.summary,
    publisher: { '@id': person['@id'] },
    inLanguage: 'en',
  },
  {
    '@type': ['/', '/about', '/resume'].includes(path) ? 'ProfilePage' : 'WebPage',
    '@id': pageId,
    url: canonical,
    name: pageTitle,
    description,
    isPartOf: { '@id': websiteId },
    ...(['/', '/about', '/resume'].includes(path) ? { mainEntity: { '@id': person['@id'] } } : {}),
  },
];
if (schemaType) {
  const date = published ? new Date(published) : undefined;
  const updated = modified ? new Date(modified) : undefined;
  graph.push({
    '@type': schemaType,
    '@id': `${canonical}#work`,
    name: title,
    headline: title,
    description,
    url: canonical,
    image: imageUrl,
    author: { '@id': person['@id'] },
    mainEntityOfPage: { '@id': pageId },
    ...(date && !Number.isNaN(date.valueOf()) ? { datePublished: date.toISOString() } : {}),
    ...(updated && !Number.isNaN(updated.valueOf()) ? { dateModified: updated.toISOString() } : {}),
    ...(keywords ? { keywords } : {}),
    ...(projectUrl ? { sameAs: projectUrl } : {}),
  });
}
if (path !== '/') {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.href },
      ...(schemaType === 'SoftwareSourceCode' || schemaType === 'CreativeWork' ? [{
        '@type': 'ListItem', position: 2, name: 'Projects',
        item: new URL('/projects/', site).href,
      }] : []),
      {
        '@type': 'ListItem',
        position: schemaType === 'SoftwareSourceCode' || schemaType === 'CreativeWork' ? 3 : 2,
        name: title,
        item: canonical,
      },
    ],
  });
}
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
{image.startsWith('/og/') && <meta property="og:image:type" content="image/png" />}
<meta property="og:image:alt" content={`${title} — ${profile.contact.name}`} />
<meta property="og:site_name" content={`${profile.contact.name}'s portfolio`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={`${title} — ${profile.contact.name}`} />
<link rel="alternate" type="text/plain" title="LLMs" href={new URL('/llms.txt', site).href} />
{markdown && <link rel="alternate" type="text/markdown" title="Markdown" href={new URL(markdown, site).href} />}
<script type="application/ld+json" set:html={serializeJsonLd({ '@context': 'https://schema.org', '@graph': graph })} />
