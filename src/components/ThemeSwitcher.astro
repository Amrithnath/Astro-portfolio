---
import { themes } from '../themes';
---

{themes.length > 1 && (
  <div class="theme-switcher" data-theme-switcher role="group" aria-label="Color theme" hidden>
    <span class="theme-command" aria-hidden="true">:set background=</span>
    <button type="button" data-theme-option="auto" aria-label="auto" aria-pressed="false">auto</button>
    {themes.map((theme) => (
      <button
        type="button"
        data-theme-option={theme.id}
        aria-label={theme.id === 'terminal' ? 'dark' : theme.label.toLowerCase()}
        aria-pressed="false"
      >
        {theme.id === 'terminal' ? 'dark' : theme.label.toLowerCase()}
      </button>
    ))}
  </div>
)}

<script>
  function initThemeSwitcher() {
    document.querySelectorAll<HTMLElement>('[data-theme-switcher]').forEach((root) => {
      if (root.dataset.bound || !window.__theme) return;
      root.dataset.bound = 'true';
      const buttons = root.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
      const reflect = () => {
        buttons.forEach((button) => {
          const selected = button.dataset.themeOption === window.__theme.preference;
          button.setAttribute('aria-pressed', String(selected));
        });
      };
      buttons.forEach((button) => {
        button.addEventListener('click', () => window.__theme.set(button.dataset.themeOption!));
      });
      window.addEventListener('portfolio:theme-change', reflect);
      reflect();
      root.hidden = false;
    });
  }
  initThemeSwitcher();
</script>
