---
// Shared shell for the homepage and every interior page: window chrome, tabs, status bar, footer.
import TerminalWindow from './ui/TerminalWindow.astro';
import TerminalNav from './TerminalNav.astro';
import TerminalFooter from './TerminalFooter.astro';
import ThemeSwitcher from './ThemeSwitcher.astro';
import { isIndexablePath } from '../lib/seo';

export interface Props {
  currentPage?: string;
  /** Pages with their own live input (e.g. the resume CLI) hide the decorative footer cursor. */
  footerCursor?: boolean;
}

const { currentPage = '/', footerCursor = true } = Astro.props;
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<TerminalWindow>
  <TerminalNav slot="tabs" currentPage={currentPage} />
  <div class="terminal-status" slot="status">
    <div class="status-left">
      <span class="branch">📁 ~/portfolio</span>
      <span class="git-branch">git:(main)</span>
      <span class="status-indicator">✓</span>
    </div>
    <div class="status-right">
      <ThemeSwitcher />
    </div>
  </div>
  <main
    id="main-content"
    tabindex="-1"
    data-pagefind-body={isIndexablePath(Astro.url.pathname) || undefined}
    data-pagefind-ignore={!isIndexablePath(Astro.url.pathname) || undefined}
  ><slot /></main>
</TerminalWindow>
<TerminalFooter showCursor={footerCursor} />
