---
import { defaultTheme, themes } from '../themes';
---

<script is:inline data-astro-rerun define:vars={{ themes, defaultTheme }}>
  (() => {
    if (window.__theme) {
      window.__theme.set(window.__theme.preference);
      return;
    }
    const key = 'portfolio-theme';
    const legacyKey = 'portfolio-layout-theme';
    const findTheme = (id) => themes.find((theme) => theme.id === id);
    const media = window.matchMedia?.('(prefers-color-scheme: light)');
    let preference = 'auto';
    const apply = (id, persist = true) => {
      if (id !== 'auto' && !findTheme(id)) return false;
      preference = id;
      const theme = findTheme(id) || themes.find((theme) =>
        theme.colorScheme === (media?.matches ? 'light' : 'dark')) || findTheme(defaultTheme);
      document.documentElement.dataset.theme = theme.id;
      document.documentElement.style.colorScheme = theme.colorScheme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme.themeColor);
      if (persist) {
        try {
          if (id === 'auto') localStorage.removeItem(key);
          else localStorage.setItem(key, id);
        } catch { /* Storage may be disabled; the in-memory preference still works. */ }
      }
      window.dispatchEvent(new CustomEvent('portfolio:theme-change', {
        detail: { theme: theme.id, preference },
      }));
      return true;
    };
    try {
      const saved = localStorage.getItem(key);
      const legacy = localStorage.getItem(legacyKey);
      preference = findTheme(saved) ? saved : saved === null && findTheme(legacy) ? legacy : 'auto';
      localStorage.removeItem(legacyKey);
    } catch { /* Follow the system even when storage is unavailable. */ }
    window.__theme = Object.freeze({
      get current() { return document.documentElement.dataset.theme; },
      get preference() { return preference; },
      set: (id) => apply(id),
      auto: () => apply('auto'),
    });
    apply(preference);
    media?.addEventListener('change', () => {
      if (preference === 'auto') apply('auto', false);
    });
    window.addEventListener('storage', (event) => {
      if (event.key === key || event.key === null) {
        apply(findTheme(event.newValue) ? event.newValue : 'auto', false);
      }
    });
  })();
</script>
