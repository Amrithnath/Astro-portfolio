---
import { defaultTheme, themes } from '../themes';
---

<script is:inline data-astro-rerun define:vars={{ themes, defaultTheme }}>
  (() => {
    if (window.__theme) {
      window.__theme.set(window.__theme.current);
      return;
    }
    const key = 'portfolio-theme';
    const legacyKey = 'portfolio-layout-theme';
    const findTheme = (id) => themes.find((theme) => theme.id === id);
    const apply = (id, persist = true) => {
      const theme = findTheme(id);
      if (!theme) return false;
      document.documentElement.dataset.theme = theme.id;
      document.documentElement.style.colorScheme = theme.colorScheme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme.themeColor);
      if (persist) {
        try { localStorage.setItem(key, theme.id); } catch { /* Storage may be disabled. */ }
      }
      window.dispatchEvent(new CustomEvent('portfolio:theme-change', { detail: { theme: theme.id } }));
      return true;
    };
    let selected = defaultTheme;
    try {
      const saved = localStorage.getItem(key);
      const legacy = localStorage.getItem(legacyKey);
      selected = findTheme(saved) ? saved : saved === null && findTheme(legacy) ? legacy : defaultTheme;
      localStorage.removeItem(legacyKey);
    } catch { /* The server-rendered default also works without storage or JavaScript. */ }
    window.__theme = Object.freeze({
      get current() { return document.documentElement.dataset.theme; },
      set: (id) => apply(id),
    });
    apply(selected);
    window.addEventListener('storage', (event) => {
      if (event.key === key || event.key === null) {
        apply(findTheme(event.newValue) ? event.newValue : defaultTheme, false);
      }
    });
  })();
</script>
