---
import Prompt from '../ui/Prompt.astro';
import Card from '../ui/Card.astro';
import { exifRows, type PhotoExif } from '../../lib/photos';
interface Props {
  data: PhotoExif;
}
const { data } = Astro.props;
const rows = exifRows(data);
---

{rows.length > 0 && (
  <section aria-labelledby="exif-heading" class="exif-panel">
    <Card>
      <h2 id="exif-heading">Photo information</h2>
      <Prompt command="exiftool photo" />
      <dl>
        {rows.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{label === 'Taken' && data.date
              ? <time datetime={data.date.toISOString()}>{value}</time>
              : value}</dd>
          </div>
        ))}
      </dl>
    </Card>
  </section>
)}
<style>
  .exif-panel {
    margin-block: var(--space-4);
  }
  dl {
    margin-bottom: 0;
  }
  dl div {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  dt {
    min-width: 14ch;
    color: var(--color-accent);
  }
  dd {
    margin: 0 0 var(--space-2);
    overflow-wrap: anywhere;
  }
  dd::before {
    content: ': ';
  }
</style>
