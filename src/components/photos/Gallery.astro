---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import PhotoImage from './PhotoImage.astro';
import { remoteImage, placeName, placeSlug, tagIndex, placeIndex } from '../../lib/photos';
interface Props {
  entries: CollectionEntry<'photos'>[];
  albums?: CollectionEntry<'albums'>[];
  filtering?: boolean;
}
const { entries, albums = [], filtering = false } = Astro.props;
const photos = await Promise.all(
  entries.map(async (photo) => ({
    ...photo,
    full: photo.data.remote
      ? remoteImage(photo.data.remote).src
      : (
          await getImage({
            src: photo.data.image as ImageMetadata,
            width: Math.min(photo.data.image!.width, 2400),
            format: 'webp',
          })
        ).src,
  }))
);
const filters = [
  ...tagIndex(entries).map((t) => ({ kind: 'tag', ...t })),
  ...placeIndex(entries).map((p) => ({ kind: 'place', ...p })),
  ...albums.map((a) => ({
    kind: 'album',
    slug: a.id,
    name: a.data.title,
    count: entries.filter((p) => p.data.albums.some((ref) => ref.id === a.id)).length,
  })),
];
---

<div data-photo-gallery>
  {
    filtering && (
      <>
        <div data-photo-filters hidden aria-label="Filter photographs" class="filters">
          {filters.map((f) => (
            <button
              class="btn btn-ghost"
              type="button"
              data-filter={f.kind}
              data-value={f.slug}
              aria-pressed="false"
            >
              --{f.kind} {f.name} ({f.count})
            </button>
          ))}
        </div>
        <p data-filter-prompt aria-live="polite">
          $ ls ~/photography
        </p>
        <p data-filter-result aria-live="polite">
          {photos.length} photos
        </p>
      </>
    )
  }
  <ul class="gallery" role="list">
    {
      photos.map((photo, index) => (
        <li
          class="gallery-item"
          data-filters={JSON.stringify({
            tag: photo.data.tags ?? [],
            place: photo.data.location ? [placeSlug(photo.data.location)] : [],
            album: photo.data.albums.map((a) => a.id),
          })}
        >
          <figure>
            <a
              class="gallery-link"
              href={photo.full}
              data-full={photo.full}
              data-alt={photo.data.alt}
              data-title={photo.data.title}
              data-caption={[
                photo.data.caption,
                photo.data.location && placeName(photo.data.location),
                photo.data.camera,
                photo.data.lens,
                photo.data.settings,
              ]
                .filter(Boolean)
                .join(' — ')}
              aria-label={'View ' + photo.data.title + ' full size'}
            >
              <PhotoImage
                photo={photo}
                eager={index < 3}
                priority={index === 0}
                sizes="(max-width: 48rem) 100vw, (max-width: 64rem) 50vw, 33vw"
              />
            </a>
            <figcaption>
              <a class="gallery-title" href={'/photography/' + photo.id + '/'}>
                {photo.data.title}
              </a>
              {photo.data.location && (
                <a href={'/photography/places/' + placeSlug(photo.data.location) + '/'}>
                  {placeName(photo.data.location)}
                </a>
              )}
              {photo.data.date && (
                <time class="gallery-meta" datetime={photo.data.date.toISOString()}>
                  {photo.data.date.toISOString().slice(0, 10)}
                </time>
              )}
              {[photo.data.camera, photo.data.lens, photo.data.settings].some(Boolean) && (
                <span class="gallery-meta">
                  {[photo.data.camera, photo.data.lens, photo.data.settings]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              )}
              {(photo.data.tags ?? []).map((tag) => (
                <a href={'/photography/tags/' + tag + '/'}>#{tag}</a>
              ))}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
  <dialog class="lightbox" aria-label="Photo viewer">
    <figure class="lightbox-figure">
      <img class="lightbox-image" alt="" decoding="async" />
      <figcaption class="lightbox-caption"></figcaption>
    </figure>
    <div class="lightbox-controls">
      <button type="button" class="btn" data-action="prev" aria-label="Previous photo"
        >‹ prev</button
      >
      <button type="button" class="btn" data-action="close" aria-label="Close viewer"
        >✕ close</button
      >
      <button type="button" class="btn" data-action="next" aria-label="Next photo">next ›</button>
    </div>
  </dialog>
</div>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filters button {
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  [data-filter-prompt] {
    overflow-wrap: anywhere;
  }

  .filters[hidden],
  .gallery-item[hidden] {
    display: none;
  }
  button[aria-pressed='true'] {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .gallery {
    columns: 3 18rem;
    column-gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-item {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }

  figure {
    margin: 0;
  }

  .gallery-link {
    display: block;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition: border-color var(--transition-fast);
  }

  .gallery-link:hover,
  .gallery-link:focus-visible {
    border-color: var(--color-accent);
  }

  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .gallery-title {
    color: var(--color-text);
    font-weight: 700;
  }

  .gallery-meta {
    color: var(--color-muted);
  }

  .lightbox {
    width: min(96vw, 110rem);
    max-height: 96vh;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
  }

  .lightbox-image {
    display: block;
    max-width: 100%;
    max-height: calc(96vh - 8rem);
    margin: 0 auto;
    object-fit: contain;
  }

  .lightbox-caption {
    justify-content: center;
    color: var(--color-muted);
    text-align: center;
  }

  .lightbox-controls {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
</style>

<script>
  function initGallery() {
    const filters = document.querySelector<HTMLElement>('[data-photo-filters]');
    if (filters && !filters.dataset.ready) {
      filters.dataset.ready = 'true';
      filters.hidden = false;
      const active = new Map<string, string>();
      filters.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          'button[data-filter]'
        );
        if (!button) return;
        const kind = button.dataset.filter!;
        const value = button.dataset.value!;
        if (active.get(kind) === value) active.delete(kind);
        else active.set(kind, value);
        filters.querySelectorAll<HTMLButtonElement>('button[data-filter]').forEach((b) => {
          b.setAttribute('aria-pressed', String(active.get(b.dataset.filter!) === b.dataset.value));
        });
        let count = 0;
        document.querySelectorAll<HTMLElement>('.gallery-item').forEach((item) => {
          const values = JSON.parse(item.dataset.filters!);
          item.hidden = ![...active].every(([key, val]) => values[key].includes(val));
          if (!item.hidden) count++;
        });
        const prompt = document.querySelector<HTMLElement>('[data-filter-prompt]');
        if (prompt)
          prompt.textContent =
            '$ ls ~/photography' +
            [...active].map(([key, val]) => ' --' + key + ' ' + val).join('');
        const result = document.querySelector<HTMLElement>('[data-filter-result]');
        if (result) result.textContent = count + ' photos';
      });
    }
    document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach(initLightbox);
  }

  function initLightbox(root: HTMLElement) {
    const dialog = root.querySelector<HTMLDialogElement>('.lightbox');
    const allLinks = [...root.querySelectorAll<HTMLAnchorElement>('.gallery-link')];
    const visibleLinks = () =>
      allLinks.filter((link) => !link.closest<HTMLElement>('.gallery-item')?.hidden);
    let links = visibleLinks();
    if (!dialog || !links.length || dialog.dataset.ready) return;
    dialog.dataset.ready = 'true';
    const image = dialog.querySelector<HTMLImageElement>('.lightbox-image')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox-caption')!;
    let current = 0;
    let opener: HTMLElement | null = null;

    const show = (index: number) => {
      current = (index + links.length) % links.length;
      const { full = '', alt = '', title = '', caption: text = '' } = links[current].dataset;
      image.src = full;
      image.alt = alt;
      caption.textContent = text ? `${title} — ${text}` : title;
    };

    allLinks.forEach((link) =>
      link.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        opener = link;
        links = visibleLinks();
        show(links.indexOf(link));
        dialog.showModal();
      })
    );
    dialog.addEventListener('click', (event) => {
      const action = (event.target as HTMLElement).closest<HTMLElement>('[data-action]')?.dataset
        .action;
      if (action === 'prev') show(current - 1);
      else if (action === 'next') show(current + 1);
      else if (action === 'close' || event.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });
    dialog.addEventListener('close', () => opener?.focus());
  }

  initGallery();
</script>
