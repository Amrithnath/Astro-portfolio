---
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import TerminalShell from '../../features/terminal/TerminalShell.astro';
import TerminalWip from '../../features/terminal/TerminalWip.astro';
import { defaultTheme } from '../../features/theme';
import { isWip } from '../../features/terminal/wip';
import type { PaneContext } from '../../features/terminal/panes';

export interface Props extends HeadProps {
  currentPage?: string;
  lang?: string;
  footerCursor?: boolean;
  panes?: PaneContext;
}

const { currentPage = '/', lang = 'en', footerCursor = true, panes, ...head } = Astro.props;
const wip = isWip(currentPage);
---

<!DOCTYPE html>
<html lang={lang} data-theme={defaultTheme}>
  <head>
    <BaseHead {...head} noindex={wip ? true : head.noindex} />
    <slot name="head" />
  </head>
  <body>
    <TerminalShell
      currentPage={currentPage}
      footerCursor={wip ? true : footerCursor}
      title={head.title}
      description={head.description}
      panes={wip ? undefined : panes}
    >
      {wip ? <TerminalWip title={wip.title} note={wip.note} /> : <slot />}
    </TerminalShell>
  </body>
</html>
