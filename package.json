{
  "name": "amrithnath-portfolio",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "wedding:api": "node wedding-upload-server/server.js",
    "wedding:api:dev": "node --watch wedding-upload-server/server.js",
    "api:go": "go run ./cmd/wedding-api",
    "api:go:test": "go test ./...",
    "api:go:lint": "golangci-lint run ./...",
    "proto:generate": "PATH=$(go env GOPATH)/bin:$PATH buf generate",
    "proto:lint": "PATH=$(go env GOPATH)/bin:$PATH buf lint",
    "admin:dev": "pnpm --dir admin-ui dev",
    "admin:build": "pnpm --dir admin-ui build",
    "admin:preview": "pnpm --dir admin-ui preview",
    "check": "astro check",
    "check:seo": "node scripts/check-agentic-seo.mjs",
    "check:theme": "node scripts/check-theme-system.mjs",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "verify": "pnpm build && pnpm check:seo && pnpm check:theme && pnpm check:links",
    "commitlint": "commitlint"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-code": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
