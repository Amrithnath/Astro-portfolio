{
  "name": "amrithnath-portfolio",
  "type": "module",
  "version": "2.4.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "wedding:api": "node project-archive/wedding-upload-server/server.js",
    "wedding:api:dev": "node --watch project-archive/wedding-upload-server/server.js",
    "api:go": "cd project-archive/wedding-api && go run ./cmd/wedding-api",
    "api:go:test": "cd project-archive/wedding-api && go test ./...",
    "api:go:lint": "cd project-archive/wedding-api && golangci-lint run ./...",
    "proto:generate": "cd project-archive && PATH=$(go env GOPATH)/bin:$PATH buf generate",
    "proto:lint": "cd project-archive && PATH=$(go env GOPATH)/bin:$PATH buf lint",
    "admin:dev": "pnpm --dir project-archive/admin-ui dev",
    "admin:build": "pnpm --dir project-archive/admin-ui build",
    "admin:preview": "pnpm --dir project-archive/admin-ui preview",
    "check": "astro check",
    "check:seo": "node scripts/check-agentic-seo.mjs",
    "check:theme": "node scripts/check-theme-system.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:cms-auth": "node --test \"workers/cms-auth/test/*.test.js\"",
    "test:views": "node --test \"workers/views/test/*.test.js\"",
    "check:links": "node scripts/check-links.mjs",
    "check:headers": "node scripts/sync-vercel-headers.mjs --check",
    "check:photos": "node scripts/check-photos.mjs",
    "sync:headers": "node scripts/sync-vercel-headers.mjs",
    "verify": "pnpm build && pnpm check:seo && pnpm check:theme && pnpm check:links && pnpm check:headers && pnpm check:photos && pnpm check:csp",
    "commitlint": "commitlint",
    "lighthouse": "pnpm dlx @lhci/cli@0.15.1 autorun",
    "test:photos": "node --test tests/photos/*.test.mjs",
    "photos:ingest": "node scripts/photos-ingest.mjs",
    "photos:locate": "node scripts/photos-locate.mjs",
    "check:csp": "node --test tests/csp/*.test.mjs && node scripts/check-csp.mjs",
    "test:visual": "playwright test --project=visual-desktop --project=visual-mobile"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/fira-code": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@sveltia/cms": "0.253.1",
    "aws4fetch": "1.0.20",
    "exifr": "7.1.3",
    "lightningcss": "^1.33.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.153.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
