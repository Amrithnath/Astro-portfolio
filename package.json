    "astro": "^7.4.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
